<?xml version="1.0"?>
<ruleset name="GestoJob"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0
                             https://pmd.sourceforge.net/ruleset_2_0_0.xsd">

  <description>
    Ruleset PMD maison — reprend les catégories intégrées bestpractices,
    design et errorprone (autant de garde-fous), et en exclut les règles
    qui heurtent des choix maison assumés ou produisent du bruit :
      - tests multi-asserts et tests via Mockito.verify (on asserte le
        comportement, pas « un assert par test ») ;
      - GuardLogStatement : les logs sont déjà en SLF4J paramétré ({}) ;
      - LawOfDemeter / DataClass / LoosePackageCoupling : bruyants et en
        conflit avec les DTO/entités de frontière ;
      - AvoidDuplicateLiterals / AvoidFieldNameMatchingMethodName :
        littéraux répétés de tests et résolveurs statiques volontaires.
    Objectif : 0 violation. Rapport non bloquant (cf. pom.xml).
  </description>

  <rule ref="category/java/bestpractices.xml">
    <exclude name="UnitTestContainsTooManyAsserts"/>
    <exclude name="UnitTestShouldIncludeAssert"/>
    <exclude name="GuardLogStatement"/>
  </rule>

  <rule ref="category/java/design.xml">
    <exclude name="LawOfDemeter"/>
    <exclude name="DataClass"/>
    <exclude name="LoosePackageCoupling"/>
    <!-- Règles de taille structurelles réintroduites plus bas, restreintes au
         code de production. -->
    <exclude name="TooManyMethods"/>
    <exclude name="ExcessiveImports"/>
  </rule>

  <!-- TooManyMethods et ExcessiveImports sont des règles de conception de
       production : une classe de test porte légitimement de nombreuses méthodes
       (une par cas) et de nombreux imports (mocks, DTO, fixtures). On les
       conserve pour le code de production, mais on les neutralise sur les classes
       de test (nom terminé par « Test ») plutôt que de morceler des tests
       cohérents ou de brider leurs dépendances. -->
  <rule ref="category/java/design.xml/TooManyMethods">
    <properties>
      <property name="violationSuppressXPath"
                value="//*[matches(@SimpleName, '.*Test$')]"/>
    </properties>
  </rule>

  <rule ref="category/java/design.xml/ExcessiveImports">
    <properties>
      <property name="violationSuppressXPath"
                value="//*[matches(@SimpleName, '.*Test$')]"/>
    </properties>
  </rule>

  <rule ref="category/java/errorprone.xml">
    <exclude name="AvoidDuplicateLiterals"/>
    <exclude name="AvoidFieldNameMatchingMethodName"/>
  </rule>

</ruleset>
