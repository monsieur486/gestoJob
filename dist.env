# Configuration base de données PostgreSQL
POSTGRES_DB=gesto_job_db
POSTGRES_USER=gesto_job_db_user
POSTGRES_PASSWORD=gesto_job_db_pass

MAIL_USERNAME=xxx
MAIL_PASSWORD=xxx

DOCKER_UI_PORT=8082

MAX_ENTREPRISES_PAR_PAGE=10
MAX_ANNONCESS_PAR_PAGE=10
MAX_POSITIFS_PAR_PAGE=10

# Comptes de connexion (obligatoires, sans valeur par défaut)
# laurent et renee : titulaires (lecture/écriture de leurs données)
# ft01 : lecteur des données de Laurent ; ft02 : lecteur des données de Renée
GESTOJOB_LAURENT_USERNAME=laurent
GESTOJOB_LAURENT_PASSWORD=ChangeMoi-Laurent1*
GESTOJOB_RENEE_USERNAME=renee
GESTOJOB_RENEE_PASSWORD=ChangeMoi-Renee1*
GESTOJOB_FT01_USERNAME=ft01
GESTOJOB_FT01_PASSWORD=ChangeMoi-Ft01*
GESTOJOB_FT02_USERNAME=ft02
GESTOJOB_FT02_PASSWORD=ChangeMoi-Ft02*
